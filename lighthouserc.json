{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3124",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3124/en",
        "http://localhost:3124/km",
        "http://localhost:3124/en/packages",
        "http://localhost:3124/en/faq",
        "http://localhost:3124/en/services/steam-wash"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
